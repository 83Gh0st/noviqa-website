# Copy this file to .env.local for local development
# and add the same values in Vercel → Project → Settings → Environment Variables

# Zoho Mail account the contact form sends through. Requires:
#  - SMTP access enabled (paid Zoho Mail plan — not available on the free tier)
#  - An app-specific password if 2FA is enabled on the mailbox
#    (Zoho: Settings → Security → App Passwords)
ZOHO_SMTP_USER=info@noviqa.ae
ZOHO_SMTP_PASS=

# Only needed if your Zoho account is on a data center other than the global
# one (smtppro.zoho.com). Leave unset otherwise.
# ZOHO_SMTP_HOST=smtppro.zoho.eu
# ZOHO_SMTP_PORT=587

# Where contact form submissions should be delivered.
# Defaults to ZOHO_SMTP_USER if not set.
CONTACT_TO_EMAIL=info@noviqa.ae
