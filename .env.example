# Copy this file to .env.local for local development
# and add the same values in Vercel → Project → Settings → Environment Variables

# Get a free API key at https://resend.com after verifying your domain
RESEND_API_KEY=

# Where contact form submissions should be delivered
CONTACT_TO_EMAIL=info@noviqa.ae

# The "from" address Resend sends as (must be on a domain verified in Resend)
CONTACT_FROM_EMAIL="Noviqa Website <noreply@noviqa.ae>"
